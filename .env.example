# --- LLM provider (pydantic-ai model identifier) ---
DA_LLM_MODEL=gemini-3.1-flash-lite
DA_JUDGE_MODEL=gemini-3.1-flash-lite

# Provider API keys (set the one matching DA_LLM_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Reflection loop tuning (critique-then-refine) ---
DA_REFLECTION_MAX_LOOPS=3

# --- RAG ---
DA_RAG_TOP_K=6
DA_RAG_BM25_WEIGHT=0.3

# --- Food DB search usage (per source) ---
# disabled | only_semantic | only_bm25 | full
DA_OFF_USAGE=full
DA_USDA_USAGE=full
