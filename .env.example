# --- LLM provider (pydantic-ai model identifier) ---
DA_LLM_MODEL=gemini-3.5-flash-lite
DA_MEAL_IDEA_LLM_MODEL=gemini-3.5-flash-lite
# DA_LLM_MODEL can be suffixed with "#<effort>" (minimal|low|medium|high|xhigh)
# to request a non-default reasoning effort, e.g.:
# DA_LLM_MODEL="openrouter:openai/gpt-5.6-luna#high"

# Provider API keys (set the one matching DA_LLM_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Local models via Ollama (no API key needed) ---
# DA_LLM_MODEL=ollama:qwen2.5:32b
# From inside the container, `localhost` is the container itself, not the
# host running Ollama - use host.docker.internal instead.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Reflection loop tuning (critique-then-refine) ---
DA_REFLECTION_MAX_LOOPS=3

# --- RAG ---
DA_RAG_TOP_K=6
DA_RAG_BM25_WEIGHT=0.3

# --- Food DB search usage (per source) ---
# disabled | only_semantic | only_bm25 | full
DA_OFF_USAGE=full
DA_USDA_USAGE=full
