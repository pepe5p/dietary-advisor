# --- Env config ---
FLAVOR=localdev

# --- App config ---
SERVICE_NAME=dietary-advisor
PYTHONDONTWRITEBYTECODE=1
DEBUG=True

# --- LLM provider (pydantic-ai model identifier) ---
# Examples:
#   openai:gpt-4o-mini
#   openai:gpt-4o
#   anthropic:claude-3-5-sonnet-latest
#   google-gla:gemini-1.5-flash
#   ollama:llama3.1
DA_LLM_MODEL=openai:gpt-4o-mini

# Provider API keys (set the one matching DA_LLM_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- USDA FoodData Central ---
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY

# --- Storage paths ---
DA_DATA_DIR=./.data
DA_CHROMA_DIR=./.data/chroma
DA_PROFILE_DB=./.data/profiles.sqlite
DA_USDA_CACHE=./.data/usda_cache.sqlite
DA_CORPUS_DIR=./dietary_advisor/knowledge/corpus

# --- Reflection loop tuning (Generate-Score-Refine) ---
DA_REFLECTION_MAX_LOOPS=3
DA_ENTAILMENT_THRESHOLD=0.8
DA_FACTUALITY_THRESHOLD=-1.0

# --- RAG ---
DA_RAG_TOP_K=6
DA_RAG_BM25_WEIGHT=0.3
