# --- LLM provider (pydantic-ai model identifier) ---
DA_LLM_MODEL=gemini-2.5-flash
# Optional separate judge model for the G-Eval soft-preference judge.
# Falls back to DA_LLM_MODEL when unset.
# DA_JUDGE_MODEL=

# Groq free tier: raise timeout so 429 Retry-After backoffs do not abort the run
# DA_LLM_REQUEST_TIMEOUT_S=300
# DA_LLM_MAX_RETRIES=6

# Provider API keys (set the one matching DA_LLM_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Reflection loop tuning (Generate-Score-Refine) ---
DA_REFLECTION_MAX_LOOPS=3

# --- RAG ---
DA_RAG_TOP_K=6
DA_RAG_BM25_WEIGHT=0.3
